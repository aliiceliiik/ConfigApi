{
  "Api": {
    "Scheme": "http",
    "Host": "localhost",
    "Port": 5095
  },
  "Tenancy": {
    "PortHosts": {
      "5201": "acme.localhost",
      "5202": "beta.localhost",
      "5203": "admin.localhost"
    }
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "configapi:mvc:",
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
