@inject ConfigApi.Mvc.Services.ITenantSelection TenantSelection
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConfigApi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/site.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Products" asp-action="Index">ConfigApi</a>

            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav flex-grow-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (!User.IsInRole(UserRole.SuperAdmin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Products" asp-action="Index">Ürünler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">Sepet</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">Siparişlerim</a>
                            </li>
                        }

                        @if (User.IsInRole(UserRole.TenantAdmin) || User.IsInRole(UserRole.SuperAdmin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Admin" asp-action="Orders">Yönetim</a>
                            </li>
                        }
                    }
                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(UserRole.SuperAdmin) && TenantSelection.SelectedTenantId is not null)
                    {
                        <div class="d-flex align-items-center me-3">
                            <span class="badge bg-warning text-dark me-2">@TenantSelection.SelectedTenantName</span>
                            <form asp-controller="Tenants" asp-action="Clear" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">Değiştir</button>
                            </form>
                        </div>
                    }

                    <span class="navbar-text me-3">@User.Identity.Name</span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Çıkış</button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
