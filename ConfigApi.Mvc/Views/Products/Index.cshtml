@functions {
    Dictionary<string, string> RouteValues(ProductSearchRequest filter, int page)
    {
        var values = new Dictionary<string, string> { ["page"] = page.ToString() };

        if (!string.IsNullOrWhiteSpace(filter.Search)) values["search"] = filter.Search;
        if (filter.MinPrice is not null) values["minPrice"] = filter.MinPrice.Value.ToString("0.##");
        if (filter.MaxPrice is not null) values["maxPrice"] = filter.MaxPrice.Value.ToString("0.##");
        if (filter.InStockOnly) values["inStockOnly"] = "true";
        if (filter.Sort != ProductSort.Relevance) values["sort"] = ((int)filter.Sort).ToString();

        return values;
    }
}

<form asp-action="Index" method="get" class="card shadow-sm mb-4" id="filterForm">
    <div class="card-body">
