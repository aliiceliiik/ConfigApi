                <input type="text" name="search" value="@filter.Search" id="searchBox"
                       class="form-control" placeholder="Ürün adı veya açıklama..."
                       autocomplete="off" />
                <div id="suggestBox" class="list-group position-absolute w-100 shadow"
                     style="z-index:1000; display:none; top:100%"></div>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Min ₺</label>
                <input type="number" name="minPrice" value="@filter.MinPrice"
                       step="0.01" min="0" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Max ₺</label>
                <input type="number" name="maxPrice" value="@filter.MaxPrice"
                       step="0.01" min="0" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Sırala</label>
                <select name="sort" class="form-select">
                    <option value="0" selected="@(filter.Sort == ProductSort.Relevance)">İlgi</option>
                    <option value="1" selected="@(filter.Sort == ProductSort.PriceAsc)">Fiyat artan</option>
                    <option value="2" selected="@(filter.Sort == ProductSort.PriceDesc)">Fiyat azalan</option>
                    <option value="3" selected="@(filter.Sort == ProductSort.NameAsc)">İsim</option>
                    <option value="4" selected="@(filter.Sort == ProductSort.Newest)">Yeni</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Sıfırla</a>
