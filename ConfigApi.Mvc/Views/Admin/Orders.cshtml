@model List<OrderListItemDto>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Siparişler</h4>
    <partial name="_AdminNav" />
</div>

<partial name="_Message" />

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5">Sipariş bulunmuyor.</div>
}
else
{
    <table class="table table-hover align-middle bg-white">
        <thead class="table-light">
            <tr>
                <th>Sipariş No</th>
                <th>Müşteri</th>
                <th>Tarih</th>
                <th class="text-end">Tutar</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="font-monospace">@order.OrderNumber</td>
                    <td>@order.CustomerName</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end fw-semibold">@order.TotalAmount.ToString("N2") ₺</td>
                    <td><span class="badge bg-info text-dark">@order.Status</span></td>
                    <td class="text-end">
                        <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
