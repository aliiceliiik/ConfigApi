@model PagedResult<ProductListItemDto>
@{
    ViewData["Title"] = "Ürünler";
    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Ürünler</h4>

    <form asp-action="Index" method="get" class="d-flex" style="max-width:320px">
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control form-control-sm me-2" placeholder="Ürün ara..." />
        <button type="submit" class="btn btn-sm btn-outline-primary">Ara</button>
    </form>
</div>

<partial name="_Message" />

@if (!Model.Items.Any())
{
    <div class="alert alert-light border text-center py-5">Ürün bulunamadı.</div>
}
else
{
    <div class="row g-3">
        @foreach (var product in Model.Items)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@product.Name</h6>
                        <p class="card-text text-muted small flex-grow-1">@product.Description</p>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-5 fw-semibold">@product.Price.ToString("N2") ₺</span>
                            <span class="badge bg-@(product.Stock > 0 ? "success" : "secondary")">
                                @(product.Stock > 0 ? $"Stok: {product.Stock}" : "Tükendi")
                            </span>
                        </div>

                        @if (product.Stock > 0)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="number" name="quantity" value="1" min="1"
                                       max="@Math.Min(product.Stock, 100)"
                                       class="form-control form-control-sm" style="width:80px" />
                                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Sepete Ekle</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>Stokta Yok</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
